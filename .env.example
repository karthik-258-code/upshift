# Copy to .env and fill in. The real .env is git-ignored. Never commit keys.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
TAVILY_API_KEY=

# To open merge requests on GitLab (personal access token, api scope)
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

# To open pull requests on GitHub (personal access token or fine-grained token with repo scope)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Cost guardrails in USD
DEFAULT_BUDGET_USD=2.0
DAILY_BUDGET_USD=25.0

# Sandbox executor: docker (local, free) | nebius (Serverless Jobs, billable)
EXECUTOR=docker
LOG_LEVEL=INFO
